{
  "schema": 1,
  "name": "Canonical Thistle native RV64 conformance module",
  "project": "tsconfig.json",
  "entries": [
    "src/vm/rv64-immediate.ts",
    "src/core/rv64-branch.ts",
    "src/core/rv64-arithmetic.ts"
  ],
  "generatedDir": "build/thistle-core-native",
  "outDir": "dist/thistle-core-probe",
  "moduleBaseName": "thistle-core-probe",
  "intrinsicModules": [],
  "abi": {
    "exports": "all-exported-functions"
  },
