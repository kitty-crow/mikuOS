    "I32": "i32",
    "U32": "u32",
    "I64": "i64",
    "U64": "u64",
    "F32": "f32",
    "F64": "f64",
    "Ptr": "u32"
  },
  "abiTypes": {
    "TetoMemory": "number",
    "I8": "number",
    "U8": "number",
    "I16": "number",
    "U16": "number",
    "I32": "number",
    "U32": "number",
    "I64": "bigint",
    "U64": "bigint",
    "F32": "number",
    "F64": "number",
    "Ptr": "number"
  },
  "materialiseInferredTypes": true
}
